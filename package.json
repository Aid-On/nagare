{
  "name": "@aid-on/nagare",
  "version": "0.2.5",
  "description": "Universal streaming interface built on Web Streams API for edge computing environments with reactive extensions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "keywords": [
    "streaming",
    "webstreams",
    "web-streams",
    "rxjs-like",
    "reactive",
    "edge-computing",
    "cloudflare-workers",
    "deno",
    "vercel-edge",
    "backpressure",
    "async",
    "operators",
    "typescript",
    "serverless",
    "sse",
    "server-sent-events",
    "real-time",
    "observable"
  ],
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aid-On/nagare.git"
  },
  "homepage": "https://github.com/Aid-On/nagare#readme",
  "bugs": {
    "url": "https://github.com/Aid-On/nagare/issues"
  },
  "author": "Aid-On",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild@0.21.5": "~0.25.0",
    "vite@5.4.21": "^6.4.3",
    "tinypool@1.1.1": "^2.1.2",
    "@vitest/mocker@2.1.9": "^4.1.11"
  }
}
